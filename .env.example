# HOW TO USE: copy this file to a new file named .env and replace every value.
# Never commit .env (it is git-ignored).

# 1) MongoDB Atlas -> your cluster -> Connect -> Drivers -> copy the connection string.
#    Replace <password> with your database user's password.
DB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority

# 2) Any long random text. Make one with:
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=your_random_long_secret

# 3) The address of THIS app. Local: http://localhost:3000
#    On Vercel: your live client URL, with no trailing slash.
BETTER_AUTH_URL=http://localhost:3000

# 4) The address of the Express server. Local: http://localhost:5000
#    On Vercel: your live server URL, with no trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:5000

# 5) Google Cloud Console -> APIs & Services -> Credentials -> your OAuth client.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# 6) imgbb.com -> API -> get API key.
NEXT_PUBLIC_IMGBB_KEY=your_imgbb_api_key
